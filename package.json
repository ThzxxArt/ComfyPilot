{
  "name": "comfy-pilot",
  "version": "0.2.0",
  "description": "ComfyPilot - all-in-one control tower for ComfyUI instances, models, node packs, workflows, monitoring and diagnostics.",
  "main": "./out/main/bootstrap.cjs",
  "author": "ThzxxArt",
  "license": "MIT",
  "homepage": "https://github.com/ThzxxArt/ComfyPilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThzxxArt/ComfyPilot.git"
  },
  "bugs": {
    "url": "https://github.com/ThzxxArt/ComfyPilot/issues"
  },
  "keywords": [
    "comfyui",
    "electron",
    "vue3",
    "ai",
    "stable-diffusion",
    "model-manager",
    "desktop"
  ],
  "private": false,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/postbuild.cjs",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "check:version": "node scripts/check-version.cjs",
    "check:asar": "node scripts/check-asar.cjs",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,css,scss,json,md}\"",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:behavior": "node scripts/test-behavior-ratio.cjs --fail",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/coverage-ratchet.cjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e",
    "coverage:accept": "node scripts/coverage-ratchet.cjs --update"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vue/devtools-api": "^8.2.1",
    "electron-updater": "^6.8.11",
    "js-yaml": "^5.5.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "systeminformation": "^5.33.19",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
