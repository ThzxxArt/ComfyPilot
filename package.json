{
  "name": "comfy-pilot",
  "version": "0.1.2",
  "description": "ComfyPilot - all-in-one control tower for ComfyUI instances, models, node packs, workflows, monitoring and diagnostics.",
  "main": "./out/main/bootstrap.cjs",
  "author": "ThzxxArt",
  "license": "MIT",
  "homepage": "https://github.com/ThzxxArt/ComfyPilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThzxxArt/ComfyPilot.git"
  },
  "bugs": {
    "url": "https://github.com/ThzxxArt/ComfyPilot/issues"
  },
  "keywords": [
    "comfyui",
    "electron",
    "vue3",
    "ai",
    "stable-diffusion",
    "model-manager",
    "desktop"
  ],
  "private": false,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/postbuild.cjs",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css,scss,json,md}\"",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "publish": {
    "provider": "github",
    "owner": "ThzxxArt",
    "repo": "ComfyPilot"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^12.0.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.4.3",
    "naive-ui": "^2.40.1",
    "pinia": "^2.3.0",
    "systeminformation": "^5.23.5",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "electron": "^32.2.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
